PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kcenglishkids
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Set these on the backend only. Model ID is configurable as models evolve.
# See https://ai.google.dev/gemini-api/docs/models for models available to your key.
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=
# To enable cloud drafting and audio coaching: AI_PROVIDER=gemini, then set both
# GEMINI_API_KEY and GEMINI_MODEL and restart the backend. No key goes in VITE_*.
