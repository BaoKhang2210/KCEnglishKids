{
  "version": 1,
  "timezoneOffsetMinutes": 420,
  "ageIntervals": {
    "3-4": [1, 2, 4, 7, 14],
    "4-5": [1, 3, 5, 7, 14],
    "5-6": [1, 3, 5, 7, 21]
  },
  "rules": {
    "SECURE": { "promoteBy": 1, "promoteOncePerDay": true, "promoteBeforeDue": false },
    "PRACTICE": { "promoteBy": 0, "dueFromPreviousLevel": true, "minDays": 1 },
    "REVIEW": { "demoteBy": 2, "dueInDays": 1 }
  },
  "mastered": { "maintenanceDays": 50 },
  "limits": { "dailyDueLimit": 10, "sessionLimit": 5 },
  "warmup": { "mode": "mem", "suggestWords": 3 },
  "backfill": { "diluteWindowDays": 5 }
}
